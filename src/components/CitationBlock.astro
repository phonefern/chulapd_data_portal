---
interface Props {
  id: string;
  label: string;
  value: string;
}

const { id, label, value } = Astro.props;
---

<div class="cite">
  <div class="cite__head">
    <h3>{label}</h3>
    <button class="btn cite__copy" type="button" data-copy={id}>Copy</button>
  </div>
  <pre id={id}><code>{value}</code></pre>
</div>

<style>
  .cite {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    overflow: hidden;
  }

  .cite__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 0.65rem 0.9rem;
    border-bottom: 1px solid var(--line);
    background: var(--surface-sunken);
  }

  .cite__head h3 {
    margin: 0;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .cite__copy {
    min-height: 2rem;
    padding: 0.3rem 0.7rem;
    font-size: 0.8rem;
  }

  .cite pre {
    margin: 0;
    padding: 1rem;
    overflow-x: auto;
    color: var(--ink-secondary);
    font-size: 0.82rem;
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
</style>
