---
import summary from '../data/summary-v2.1.json';

/**
 * Modality coverage for a cohort whose files have not been downloaded yet.
 *
 * Deliberately not the same component as `AvailabilityChart`. That one draws
 * verified counts; this one draws a claim plus an estimate, and the two must not
 * be mistakable for each other. The bar encodes the manifest figure, and a
 * marker on the same track shows where the count is expected to land once files
 * are verified — using the retention CheckPD v2.0 actually measured.
 */

const groups = summary.cohort.groups;
const denominator = Object.fromEntries(groups.map((g) => [g.label, g.count]));
const total = summary.cohort.total;
const reference = (summary as any).retention_reference ?? null;

const rows = summary.modalities.map((modality: any) => ({
  ...modality,
  pct: (modality.total / total) * 100,
  expectedPct:
    modality.expected_after_verification != null
      ? (modality.expected_after_verification / total) * 100
      : null,
  series: modality.by_group.map((entry: any) => ({
    label: entry.label,
    count: entry.count,
    pct: (entry.count / denominator[entry.label]) * 100,
  })),
}));

const uncertain = rows.filter((r) => r.kept_fraction_v2_0 != null && r.kept_fraction_v2_0 < 0.8);

const n = (value: number) => value.toLocaleString('en-US');
const pct = (value: number) => `${value.toFixed(1)}%`;
---

<figure class="chart">
  <figcaption class="chart__head">
    <h3 class="chart__title">Expected modality coverage</h3>
    <p class="chart__sub">
      Share of the {n(total)} selected participants the acquisition backend recorded for each
      task. Nothing has been verified against a released file yet.
    </p>
  </figcaption>

  {reference && (
    <p class="note note--warn">
      <strong>These are claims, not counts.</strong> In CheckPD v2.0 the same manifest fields
      held up almost exactly for the inertial, questionnaire and touchscreen tasks
      (98&ndash;100% survived into the release) but only
      {' '}{Math.round((reference.kept_fraction.voiceAhh_available ?? 0) * 100)}% of the
      sustained-vowel voice recordings did &mdash; voice is segmented by a separate
      preprocessing pipeline that discards clips. The hollow marker on each bar is where that
      retention puts this cohort.
    </p>
  )}

  <div class="chart__legend">
    <span class="legend"><span class="legend__bar" aria-hidden="true"></span>Recorded in the manifest</span>
    <span class="legend"><span class="legend__tick" aria-hidden="true"></span>Expected after file verification</span>
  </div>

  <div class="chart__plot">
    {rows.map((row) => (
      <div class="row">
        <div class="row__label">{row.label}</div>
        <div class="row__bar">
          <span class="bar__track">
            <span class="bar__fill" style={`--w:${row.pct.toFixed(2)}%`}></span>
            {row.expectedPct != null && (
              <span
                class="bar__marker"
                style={`--x:${row.expectedPct.toFixed(2)}%`}
                title={`expected ~${n(row.expected_after_verification)} after verification`}
              ></span>
            )}
          </span>
        </div>
        <div class="row__value">
          <span class="v-claim">{n(row.total)}</span>
          <span class="v-expected">
            {row.expected_after_verification != null ? `~${n(row.expected_after_verification)}` : '—'}
          </span>
        </div>
      </div>
    ))}
  </div>

  <details class="chart__table">
    <summary>View as table</summary>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th scope="col">Modality</th>
            <th scope="col" class="num">PD</th>
            <th scope="col" class="num">HC</th>
            <th scope="col" class="num">Manifest</th>
            <th scope="col" class="num">v2.0 retention</th>
            <th scope="col" class="num">Expected</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              {row.series.map((s: any) => <td class="num">{n(s.count)}</td>)}
              <td class="num">{n(row.total)}</td>
              <td class="num">
                {row.kept_fraction_v2_0 != null ? `${Math.round(row.kept_fraction_v2_0 * 100)}%` : '—'}
              </td>
              <td class="num">
                {row.expected_after_verification != null ? `~${n(row.expected_after_verification)}` : '—'}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>

  {uncertain.length > 0 && (
    <p class="chart__foot">
      Most likely to move: {uncertain.map((r) => r.label).join(', ')}.
    </p>
  )}
</figure>

<style>
  .chart { margin: 0; }
  .chart__head { margin-bottom: var(--space-2); }
  .chart__title { margin: 0; }
  .chart__sub {
    margin: 0.3rem 0 0;
    font-size: 0.86rem;
    color: var(--ink-secondary);
    max-width: 62ch;
  }

  .chart__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.1rem;
    margin-block: var(--space-3) var(--space-2);
    font-size: 0.8rem;
    color: var(--ink-secondary);
  }

  .legend { display: inline-flex; align-items: center; gap: 0.4rem; }

  .legend__bar {
    width: 14px;
    height: 9px;
    border-radius: 2px;
    background: var(--series-pd);
  }

  .legend__tick {
    width: 2px;
    height: 13px;
    background: var(--ink-primary);
    box-shadow: 0 0 0 1.5px var(--surface-card);
  }

  .chart__plot { display: grid; gap: 0.5rem; }

  .row {
    display: grid;
    grid-template-columns: minmax(9rem, 14rem) 1fr auto;
    gap: 0.35rem 1rem;
    align-items: center;
  }

  .row__label { font-size: 0.86rem; color: var(--ink-primary); }

  .bar__track {
    position: relative;
    display: block;
    height: 9px;
    border-radius: 2px;
    background: var(--series-track);
  }

  .bar__fill {
    display: block;
    height: 100%;
    width: var(--w);
    border-radius: 0 4px 4px 0;
    background: var(--series-pd);
    /* Hatched, so a provisional bar never reads as a solid measured one. */
    background-image: repeating-linear-gradient(
      135deg,
      rgb(255 255 255 / 28%) 0 3px,
      transparent 3px 7px
    );
  }

  .bar__marker {
    position: absolute;
    top: -2px;
    bottom: -2px;
    left: var(--x);
    width: 2px;
    background: var(--ink-primary);
    box-shadow: 0 0 0 1.5px var(--surface-card);
    cursor: help;
  }

  .row__value {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .v-claim { min-width: 3rem; text-align: right; color: var(--ink-primary); font-weight: 550; }
  .v-expected { min-width: 3.4rem; text-align: right; color: var(--ink-muted); }

  .chart__table { margin-top: var(--space-4); }

  .chart__table summary {
    cursor: pointer;
    font-size: 0.84rem;
    color: var(--ink-secondary);
    width: fit-content;
  }

  .chart__table summary:hover { color: var(--brand); }
  .chart__table .table-scroll { margin-top: var(--space-2); }

  .chart__foot {
    margin: var(--space-3) 0 0;
    font-size: 0.82rem;
    color: var(--ink-muted);
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: 1fr auto;
    }

    .row__bar {
      grid-column: 1 / -1;
      order: 3;
    }
  }
</style>
