---
import { dataset } from '../data/dataset';

const { pathname } = Astro.url;
const items = [
  { href: dataset.path, label: 'Overview', exact: true },
  { href: `${dataset.path}files/`, label: 'Files' },
  { href: `${dataset.path}documentation/`, label: 'Documentation' },
  { href: `${dataset.path}access/`, label: 'Access' },
  { href: `${dataset.path}citation/`, label: 'Citation' },
];

const isCurrent = (item: (typeof items)[number]) =>
  item.exact ? pathname === item.href : pathname.startsWith(item.href);
---

<nav class="dataset-nav" aria-label={`${dataset.shortTitle} sections`}>
  <div class="wrap dataset-nav__inner">
    {items.map((item) => (
      <a href={item.href} aria-current={isCurrent(item) ? 'page' : undefined}>{item.label}</a>
    ))}
  </div>
</nav>

<style>
  .dataset-nav {
    border-block: 1px solid var(--line);
    background: var(--surface-sunken);
  }

  .dataset-nav__inner {
    display: flex;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .dataset-nav__inner::-webkit-scrollbar {
    display: none;
  }

  .dataset-nav a {
    padding: 0.8rem 1rem;
    border-bottom: 3px solid transparent;
    color: var(--ink-secondary);
    font-size: 0.88rem;
    font-weight: 550;
    text-decoration: none;
    white-space: nowrap;
  }

  .dataset-nav a:first-child {
    margin-left: -1rem;
  }

  .dataset-nav a:hover {
    color: var(--ink-primary);
    background: var(--surface-card);
  }

  .dataset-nav a[aria-current='page'] {
    color: var(--brand);
    border-bottom-color: var(--brand);
    background: var(--surface-card);
  }

  @media (max-width: 640px) {
    .dataset-nav a:first-child {
      margin-left: 0;
    }
  }
</style>
