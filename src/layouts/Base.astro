---
import '../styles/tokens.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PreviewBanner from '../components/PreviewBanner.astro';
import { UI, counterpart, hasThai, langOf, type Lang } from '../data/i18n';
import { isDemo } from '../data/deploy';

interface Props {
  title: string;
  description: string;
  /** Set on the DOI landing page so crawlers resolve to the canonical URL. */
  canonical?: string;
  /** Defaults to the language implied by the route. */
  lang?: Lang;
}

const { title, description, canonical } = Astro.props;
const lang: Lang = Astro.props.lang ?? langOf(Astro.url.pathname);
const t = UI[lang];
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, Astro.site);

// Only emit hreflang where a real translation exists, so search engines are not
// pointed at the home page as though it were a translation of an inner page.
const alternate =
  lang === 'th' || hasThai(Astro.url.pathname)
    ? {
        self: lang,
        other: lang === 'th' ? 'en' : 'th',
        href: new URL(counterpart(Astro.url.pathname), Astro.site).href,
      }
    : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {isDemo && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="icon" href="/brand/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    {alternate && (
      <>
        <link rel="alternate" hreflang={alternate.self} href={canonicalUrl.href} />
        <link rel="alternate" hreflang={alternate.other} href={alternate.href} />
        <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site).href} />
      </>
    )}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:locale" content={lang === 'th' ? 'th_TH' : 'en_US'} />
    <slot name="head" />
    <script is:inline>
      // Light is the default. Apply a saved explicit choice before first paint.
      try {
        const saved = localStorage.getItem('checkpd-theme');
        document.documentElement.dataset.theme = saved === 'dark' ? 'dark' : 'light';
      } catch (_) {
        document.documentElement.dataset.theme = 'light';
      }
    </script>
  </head>

  <body>
    <a class="skip" href="#main">{t.skip}</a>
    {isDemo && <PreviewBanner lang={lang} />}
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <script is:inline>
      document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
        button.addEventListener('click', () => {
          const root = document.documentElement;
          const current = root.dataset.theme === 'dark' ? 'dark' : 'light';
          const next = current === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try {
            localStorage.setItem('checkpd-theme', next);
          } catch (_) {
            /* nothing to persist to - the toggle still works for this page */
          }
        });
      });

      document.querySelectorAll('[data-copy]').forEach((button) => {
        button.addEventListener('click', async () => {
          const target = document.getElementById(button.dataset.copy);
          if (!target) return;
          try {
            await navigator.clipboard.writeText(target.textContent.trim());
            const original = button.textContent;
            button.textContent = 'Copied';
            setTimeout(() => (button.textContent = original), 1400);
          } catch (_) {
            const range = document.createRange();
            range.selectNodeContents(target);
            getSelection()?.removeAllRanges();
            getSelection()?.addRange(range);
          }
        });
      });
    </script>
  </body>
</html>

<style is:global>
  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    background: var(--brand);
    color: var(--brand-ink);
    padding: 0.5rem 0.9rem;
    border-radius: 0 0 var(--radius) 0;
    text-decoration: none;
  }

  .skip:focus {
    left: 0;
  }
</style>
