---
import Base from '../../layouts/Base.astro';
import { dataset, portal } from '../../data/dataset';

const purposes = [
  { title: 'Dataset access requests', text: 'Use the version-specific request page so the curator receives the required research and institutional details.', href: '/datasets/checkpd/v2.0/access/', label: `Request ${dataset.shortTitle}` },
  { title: 'Documentation questions', text: 'The institutional contact channel is Pending. Review the dataset documentation while the channel is being confirmed.' },
  { title: 'Report a data problem', text: 'The responsible reporting channel and response workflow are Pending institutional confirmation.' },
  { title: 'Publication notification', text: 'The curator contact channel is Pending. Verified publications using CheckPD will be listed on the publications page.', href: '/publications/', label: 'View publications' },
];
---

<Base title={`Contact - ${portal.name}`} description={`Contact routes and current channel status for ${portal.name}.`}>
  <header class="wrap page-head">
    <p class="eyebrow">Contact</p>
    <h1>Find the right route</h1>
    <p class="lede prose">{portal.operator}, under {portal.institution}, operates this portal. Contact channels are shown only when they are confirmed.</p>
  </header>

  <section class="section section--first"><div class="wrap stack">
    <p class="note note--warn"><strong>General contact channel Pending.</strong> The address in the portal configuration is a development placeholder and is intentionally not published.</p>
    <div class="contact-grid">{purposes.map((purpose) => <article class="card contact-card">
      <div><h2>{purpose.title}</h2>{purpose.href ? <span class="badge badge--brand">Route available</span> : <span class="badge">Pending</span>}</div>
      <p>{purpose.text}</p>
      {purpose.href && <a href={purpose.href}>{purpose.label}</a>}
    </article>)}</div>
  </div></section>
</Base>

<style>
  .contact-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); }
  .contact-card { display: flex; flex-direction: column; gap: var(--space-3); box-shadow: none; }
  .contact-card > div { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-3); }
  .contact-card p { color: var(--ink-secondary); }
  .contact-card a { width: fit-content; margin-top: auto; }
  @media (max-width: 680px) { .contact-grid { grid-template-columns: 1fr; } }
  @media (max-width: 430px) { .contact-card > div { flex-direction: column; gap: var(--space-2); } }
</style>

